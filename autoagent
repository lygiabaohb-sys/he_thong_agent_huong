        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const parsed = JSON.parse(String(reader.result));
            if (!Array.isArray(parsed.agents) || !Array.isArray(parsed.tasks)) {
              throw new Error('Invalid format');
            }
            state.agents = parsed.agents;
            state.tasks = parsed.tasks;
            state.activeDetailTaskId = null;
            saveState();
            renderAll();
            showToast('Đã nhập dữ liệu thành công', 'success');
          } catch (err) {
            showToast('File JSON không đúng định dạng AgentOps', 'error');
          }
        };
        reader.readAsText(file);
        e.target.value = '';
      });

