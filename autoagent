      function renderTaskCard(task) {
        const agent = getAgent(task.agentId);
        const colStyle = COLOR_MAP[agent.color] || COLOR_MAP.indigo;
        const prio = PRIORITY_META[task.priority] || PRIORITY_META.medium;
        const doneSub = (task.subtasks || []).filter((s) => s.done).length;
        const totalSub = (task.subtasks || []).length;
        const progress = Math.max(0, Math.min(100, Number(task.progress) || 0));

        let quickActionBtn = '';
        if (task.status === 'backlog') {
          quickActionBtn = `<button type="button" data-action="move-status" data-id="${esc(task.id)}" data-status="running" class="px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 hover:bg-emerald-100 text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300 flex items-center gap-1 transition"><i data-lucide="play" class="w-3 h-3"></i>Chạy</button>`;
        } else if (task.status === 'running') {
          quickActionBtn = `<button type="button" data-action="step-progress" data-id="${esc(task.id)}" class="px-2.5 py-1 rounded-lg text-xs font-medium bg-indigo-50 hover:bg-indigo-100 text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300 flex items-center gap-1 transition"><i data-lucide="fast-forward" class="w-3 h-3"></i>+15%</button>`;
        } else if (task.status === 'review') {
          quickActionBtn = `<button type="button" data-action="move-status" data-id="${esc(task.id)}" data-status="done" class="px-2.5 py-1 rounded-lg text-xs font-medium bg-indigo-600 hover:bg-indigo-700 text-white flex items-center gap-1 transition"><i data-lucide="check" class="w-3 h-3"></i>Duyệt</button>`;
        } else {
          quickActionBtn = `<span class="text-xs text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1"><i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>Xong</span>`;
        }

        return `
          <article draggable="true" data-task-id="${esc(task.id)}" class="task-card bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-3.5 shadow-2xs hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-700 cursor-pointer space-y-3">
            <div class="flex items-start justify-between gap-2">
              <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold ${prio.cls}">${esc(prio.label)}</span>
              <div class="flex items-center gap-1">
                ${task.dueDate ? `<span class="text-[11px] text-slate-400 flex items-center gap-1"><i data-lucide="calendar" class="w-3 h-3"></i>${esc(task.dueDate.slice(5))}</span>` : ''}
                <button type="button" data-action="edit-task" data-id="${esc(task.id)}" class="p-1 rounded-md text-slate-400 hover:text-indigo-600 hover:bg-slate-100 dark:hover:bg-slate-800" title="Sửa công việc">
                  <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>

            <div data-action="open-detail" data-id="${esc(task.id)}">
              <h3 class="text-sm font-semibold leading-snug text-slate-900 dark:text-slate-100">${esc(task.title)}</h3>
              ${task.prompt ? `<p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">${esc(task.prompt)}</p>` : ''}
            </div>

            ${(task.tags && task.tags.length) ? `
              <div class="flex flex-wrap gap-1.5">
                ${task.tags.slice(0, 3).map((tag) => `<span class="px-2 py-0.5 rounded-md text-[11px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">#${esc(tag)}</span>`).join('')}
              </div>
            ` : ''}

            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-[11px] font-medium">
                <span class="text-slate-500 dark:text-slate-400">${totalSub > 0 ? `Bước con: ${doneSub}/${totalSub}` : 'Tiến độ'}</span>
                <span class="text-slate-700 dark:text-slate-200">${progress}%</span>
              </div>
              <div class="w-full h-1.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                <div class="h-full rounded-full transition-all duration-300 ${task.status === 'done' ? 'bg-indigo-500' : task.status === 'running' ? 'bg-emerald-500' : 'bg-amber-500'}" style="width: ${progress}%"></div>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 min-w-0">
