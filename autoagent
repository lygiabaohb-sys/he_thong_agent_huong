      function toggleSimulation() {
        if (simTimer) {
          clearInterval(simTimer);
          simTimer = null;
        }
        state.simRunning = !state.simRunning;
        const dot = document.getElementById('simDot');
        const label = document.getElementById('simLabel');
        if (state.simRunning) {
          dot.className = 'w-2 h-2 rounded-full bg-emerald-500 pulse-dot';
          label.textContent = 'Đang mô phỏng';
          showToast('Đã bật mô phỏng tiến độ Agent trực tiếp', 'success');
          simTimer = setInterval(() => {
            const runningTasks = state.tasks.filter((t) => t.status === 'running');
            if (runningTasks.length === 0) {
              clearInterval(simTimer);
              simTimer = null;
              state.simRunning = false;
              dot.className = 'w-2 h-2 rounded-full bg-slate-400';
              label.textContent = 'Mô phỏng chạy';
              showToast('Tất cả công việc đang chạy đã hoàn tất!');
              return;
            }
            const pick = runningTasks[Math.floor(Math.random() * runningTasks.length)];
            stepTaskProgress(pick.id, 10);
          }, 2600);
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-slate-400';
          label.textContent = 'Mô phỏng chạy';
          showToast('Đã tạm dừng mô phỏng');
        }
      }

      function pickAgentByDomain(domain) {
        const direct = state.agents.find((a) => a.domain === domain);
        if (direct) return direct;
        const keywords = {
          unity: ['unity', 'c#', 'urp', 'hdrp'],
          unreal: ['unreal', 'ue5', 'blueprint', 'lumen'],
          godot: ['godot', 'gdscript'],
          game: ['game', 'gameplay', 'nhân vật'],
          graphics: ['đồ họa', 'art', '3d', 'ui', 'ux', 'thiết kế'],
          video: ['video', 'phụ đề', 'lồng tiếng', 'trailer', 'dựng'],
          software: ['phần mềm', 'code', 'lập trình', 'api', 'app'],
          qa: ['qa', 'kiểm thử', 'test', 'cân bằng'],
        };
        const keys = keywords[domain] || [];
        const matched = state.agents.find((a) => !a.isOrchestrator && keys.some((k) => (a.role + ' ' + a.name).toLowerCase().includes(k)));
        return matched || state.agents.find((a) => !a.isOrchestrator) || state.agents[0];
      }

