        const q = state.search.trim().toLowerCase();
        return state.tasks.filter((t) => {
          if (state.filterAgent !== 'all' && t.agentId !== state.filterAgent) return false;
          if (state.filterPriority !== 'all' && t.priority !== state.filterPriority) return false;
          if (q) {
            const hay = [t.title, t.prompt, (t.tags || []).join(' '), getAgent(t.agentId).name].join(' ').toLowerCase();
            if (!hay.includes(q)) return false;
          }
          return true;
        });
