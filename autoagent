        const taskAgentSel = document.getElementById('taskAgentInput');
        const prevVal = taskAgentSel.value;
        taskAgentSel.innerHTML = state.agents.map((a) => `<option value="${esc(a.id)}">${esc(a.name)} — ${esc(a.role)}</option>`).join('');
