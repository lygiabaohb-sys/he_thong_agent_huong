      function bindDragAndDrop() {
        document.querySelectorAll('.task-card[draggable="true"]').forEach((card) => {
          card.addEventListener('dragstart', (e) => {
            draggedTaskId = card.dataset.taskId;
            card.classList.add('dragging');
            if (e.dataTransfer) {
              e.dataTransfer.effectAllowed = 'move';
              e.dataTransfer.setData('text/plain', draggedTaskId);
            }
          });
          card.addEventListener('dragend', () => {
            card.classList.remove('dragging');
            draggedTaskId = null;
            document.querySelectorAll('.kanban-col').forEach((c) => c.classList.remove('drag-over'));
          });
        });

        document.querySelectorAll('.kanban-col').forEach((col) => {
          col.addEventListener('dragover', (e) => {
            e.preventDefault();
            col.classList.add('drag-over');
          });
          col.addEventListener('dragleave', () => {
            col.classList.remove('drag-over');
          });
          col.addEventListener('drop', (e) => {
            e.preventDefault();
            col.classList.remove('drag-over');
            const id = draggedTaskId || (e.dataTransfer && e.dataTransfer.getData('text/plain'));
            const newStatus = col.dataset.dropStatus;
            if (id && newStatus) {
              moveTaskStatus(id, newStatus);
            }
          });
        });
      }

      function moveTaskStatus(taskId, newStatus) {
        const task = state.tasks.find((t) => t.id === taskId);
        if (!task || task.status === newStatus) return;
        task.status = newStatus;
        if (newStatus === 'done') task.progress = 100;
        else if (newStatus === 'running' && task.progress === 0) task.progress = 10;
        else if (newStatus === 'review' && task.progress < 90) task.progress = 100;
        task.logs = task.logs || [];
        task.logs.push({ time: nowTimeStr(), text: `Chuyển trạng thái sang "${STATUS_META[newStatus].label}".` });
        saveState();
        renderAll();
        showToast(`Đã chuyển sang ${STATUS_META[newStatus].label}`, 'success');
      }

      function stepTaskProgress(taskId, delta) {
        const task = state.tasks.find((t) => t.id === taskId);
        if (!task) return;
        const next = Math.min(100, (Number(task.progress) || 0) + delta);
        task.progress = next;
        task.logs = task.logs || [];
        if (next >= 100 && task.status === 'running') {
          task.status = 'review';
          task.logs.push({ time: nowTimeStr(), text: 'Đạt 100% tiến độ — tự động chuyển sang Chờ duyệt.' });
          showToast(`"${task.title}" đã xong, chuyển sang Chờ duyệt`, 'success');
        } else {
          task.logs.push({ time: nowTimeStr(), text: `Agent cập nhật tiến độ lên ${next}%.` });
        }
        saveState();
        renderAll();
      }

