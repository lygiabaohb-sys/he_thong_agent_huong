```html
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AgentOps — Bảng Giao Việc & Theo Dõi Agent Trực Quan</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      overflow-x: hidden;
    }
    .kanban-col {
      min-height: 360px;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }
    .kanban-col.drag-over {
      background-color: rgba(99, 102, 241, 0.08);
      border-color: #6366f1;
    }
    .task-card {
      transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
    }
    .task-card.dragging {
      opacity: 0.45;
      transform: scale(0.98);
    }
    @keyframes pulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.35); }
    }
    .pulse-dot {
      animation: pulseDot 1.6s infinite ease-in-out;
    }
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.45);
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: transparent;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen antialiased">

  <!-- Top Navigation -->
  <header class="sticky top-0 z-30 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <!-- Brand -->
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-sm shrink-0">
          <i data-lucide="cpu" class="w-5 h-5"></i>
        </div>
        <div class="min-w-0">
          <h1 class="text-base sm:text-lg font-bold tracking-tight truncate">AgentOps</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 truncate">Điều phối & theo dõi Agent trực quan</p>
        </div>
      </div>

      <!-- View Switcher -->
      <nav class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl" aria-label="Chuyển chế độ xem">
        <button type="button" data-view="board" class="view-tab px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium flex items-center gap-1.5 transition">
          <i data-lucide="kanban" class="w-4 h-4"></i>
          <span>Bảng Kanban</span>
        </button>
        <button type="button" data-view="table" class="view-tab px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium flex items-center gap-1.5 transition">
          <i data-lucide="table-2" class="w-4 h-4"></i>
          <span>Danh sách</span>
        </button>
        <button type="button" data-view="agents" class="view-tab px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium flex items-center gap-1.5 transition">
          <i data-lucide="bot" class="w-4 h-4"></i>
          <span>Đội Agent</span>
        </button>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 flex-wrap">
        <button type="button" id="btnToggleSim" class="px-3 py-2 rounded-xl text-xs sm:text-sm font-medium border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-1.5 transition" title="Bật/tắt mô phỏng tiến độ chạy tự động của các Agent">
          <span id="simDot" class="w-2 h-2 rounded-full bg-slate-400"></span>
          <span id="simLabel">Mô phỏng chạy</span>
        </button>
        <button type="button" id="btnNewTask" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm flex items-center gap-1.5 transition">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Giao việc mới</span>
        </button>
        <button type="button" id="btnTheme" class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 transition" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
          <i data-lucide="moon" class="w-4 h-4 dark:hidden"></i>
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
        </button>
        <div class="relative">
          <button type="button" id="btnDataMenu" class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 transition" aria-label="Tùy chọn dữ liệu" title="Xuất / Nhập dữ liệu">
            <i data-lucide="more-vertical" class="w-4 h-4"></i>
          </button>
          <div id="dataMenuDropdown" class="hidden absolute right-0 mt-2 w-48 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-lg py-1.5 z-40">
            <button type="button" id="btnNewAgentMenu" class="w-full text-left px-3.5 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2">
              <i data-lucide="user-plus" class="w-4 h-4 text-indigo-500"></i> Thêm Agent mới
            </button>
            <button type="button" id="btnExportJson" class="w-full text-left px-3.5 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2">
              <i data-lucide="download" class="w-4 h-4 text-emerald-500"></i> Xuất dữ liệu JSON
            </button>
            <button type="button" id="btnImportJson" class="w-full text-left px-3.5 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2">
              <i data-lucide="upload" class="w-4 h-4 text-sky-500"></i> Nhập dữ liệu JSON
            </button>
            <div class="my-1 border-t border-slate-200 dark:border-slate-800"></div>
            <button type="button" id="btnResetDemo" class="w-full text-left px-3.5 py-2 text-sm text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center gap-2">
              <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Khôi phục dữ liệu mẫu
            </button>
          </div>
          <input type="file" id="importFileInput" accept="application/json,.json" class="hidden" />
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-[1440px] mx-auto px-4 sm:px-6 py-5 space-y-5">
    <!-- Orchestrator Brain Panel -->
    <section id="orchestratorPanel" class="bg-gradient-to-r from-indigo-600 via-violet-600 to-sky-600 rounded-2xl p-[1px] shadow-sm">
      <div class="bg-white dark:bg-slate-900 rounded-[15px] p-4 sm:p-5 space-y-3.5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-sm shrink-0">
              <i data-lucide="brain-circuit" class="w-5 h-5"></i>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-sm sm:text-base font-bold">Nexus Orchestrator — Đầu não điều phối</h2>
                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">Gemini 2.5 Pro</span>
                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></span> Sẵn sàng phân bổ
                </span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Nhập 1 mục tiêu tổng — đầu não sẽ tự chia nhỏ đầu việc và giao cho đúng Agent Unity, Unreal Engine, Godot, Đồ họa, Video, Phần mềm &amp; QA.</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" data-preset-goal="Xây dựng prototype game 2D hành động kèm sprite nhân vật và trailer 30s" data-preset-domain="game" class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 hover:text-indigo-700 dark:hover:bg-indigo-950 dark:hover:text-indigo-300 transition">Mẫu: Game + Trailer</button>
            <button type="button" data-preset-goal="Sản xuất video giới thiệu sản phẩm 60s kèm thumbnail đồ họa và phụ đề Việt" data-preset-domain="video" class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 hover:text-indigo-700 dark:hover:bg-indigo-950 dark:hover:text-indigo-300 transition">Mẫu: Video &amp; Đồ họa</button>
            <button type="button" data-preset-goal="Phát triển ứng dụng công cụ AI kèm giao diện UI/UX và kiểm thử tự động" data-preset-domain="software" class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 hover:text-indigo-700 dark:hover:bg-indigo-950 dark:hover:text-indigo-300 transition">Mẫu: Phần mềm AI</button>
          </div>
        </div>
        <form id="orchestratorForm" class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-1">
            <i data-lucide="sparkles" class="w-4 h-4 text-indigo-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
            <input type="text" id="orchestratorGoalInput" required placeholder="Nhập mục tiêu lớn muốn triển khai (VD: Làm game mini mới kèm bộ đồ họa nhân vật và video quảng bá)..." class="w-full pl-10 pr-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <select id="orchestratorDomainInput" class="px-3 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="auto">Tự động phân tích lĩnh vực</option>
            <option value="unity">Game Unity (C#)</option>
            <option value="unreal">Game Unreal Engine (UE5)</option>
            <option value="godot">Game Godot (GDScript)</option>
            <option value="game">Thiết kế Game tổng quát</option>
            <option value="video">Sản xuất Video</option>
            <option value="graphics">Đồ họa &amp; UI/UX</option>
            <option value="software">Phát triển Phần mềm</option>
          </select>
          <button type="submit" class="px-4 py-2.5 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm flex items-center justify-center gap-1.5 shrink-0 transition">
            <i data-lucide="send" class="w-4 h-4"></i>
            <span>Phân tách &amp; Giao việc</span>
          </button>
        </form>
      </div>
    </section>

    <!-- KPI Summary Row -->
    <section id="kpiStrip" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" aria-label="Thống kê nhanh"></section>

    <!-- Filter & Search Bar -->
    <section id="filterBar" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-4 flex flex-wrap items-center gap-3">
      <div class="relative flex-1 min-w-[200px]">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        <input type="text" id="searchInput" placeholder="Tìm tên việc, prompt, thẻ..." class="w-full pl-9 pr-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>
      <select id="filterAgent" class="px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="all">Tất cả Agent</option>
      </select>
      <select id="filterPriority" class="px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="all">Mọi độ ưu tiên</option>
        <option value="urgent">Khẩn cấp</option>
        <option value="high">Cao</option>
        <option value="medium">Trung bình</option>
        <option value="low">Thấp</option>
      </select>
      <button type="button" id="btnClearFilters" class="px-3 py-2 text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hidden">
        Xóa bộ lọc
      </button>
    </section>

    <!-- Main Dynamic View Container -->
    <section id="viewContainer" class="min-h-[420px]"></section>
  </main>

  <!-- Modal: Create / Edit Task -->
  <div id="taskModal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl w-full max-w-xl max-h-[90vh] overflow-y-auto custom-scroll">
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-200 dark:border-slate-800">
        <h2 id="taskModalTitle" class="text-base font-bold">Giao việc mới cho Agent</h2>
        <button type="button" data-close-modal="taskModal" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <form id="taskForm" class="p-5 space-y-4">
        <input type="hidden" id="taskIdInput" />
        <div>
          <label for="taskTitleInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tên công việc *</label>
          <input type="text" id="taskTitleInput" required placeholder="VD: Tổng hợp báo cáo thị trường tuần này" class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <div>
          <label for="taskPromptInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Yêu cầu / Prompt hướng dẫn cho Agent</label>
          <textarea id="taskPromptInput" rows="3" placeholder="Mô tả đầu vào, tiêu chí hoàn thành và định dạng kết quả mong muốn..." class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label for="taskAgentInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Agent phụ trách *</label>
            <select id="taskAgentInput" required class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"></select>
          </div>
          <div>
            <label for="taskStatusInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Trạng thái</label>
            <select id="taskStatusInput" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="backlog">Hàng chờ</option>
              <option value="running">Đang triển khai</option>
              <option value="review">Chờ duyệt</option>
              <option value="done">Hoàn thành</option>
            </select>
          </div>
          <div>
            <label for="taskPriorityInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Độ ưu tiên</label>
            <select id="taskPriorityInput" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="urgent">Khẩn cấp</option>
              <option value="high">Cao</option>
              <option value="medium" selected>Trung bình</option>
              <option value="low">Thấp</option>
            </select>
          </div>
          <div>
            <label for="taskDueInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Hạn hoàn thành</label>
            <input type="date" id="taskDueInput" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label for="taskProgressInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tiến độ hiện tại: <span id="taskProgressVal" class="text-indigo-600 dark:text-indigo-400">0%</span></label>
            <input type="range" id="taskProgressInput" min="0" max="100" step="5" value="0" class="w-full accent-indigo-600" />
          </div>
          <div>
            <label for="taskTagsInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Thẻ (cách nhau bằng dấu phẩy)</label>
            <input type="text" id="taskTagsInput" placeholder="VD: Nghiên cứu, Báo cáo, API" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>
        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-slate-800">
          <button type="button" data-close-modal="taskModal" class="px-4 py-2 rounded-xl text-sm font-medium border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Hủy</button>
          <button type="submit" class="px-4 py-2 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm">Lưu công việc</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Create / Edit Agent -->
  <div id="agentModal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl w-full max-w-md">
      <div class="flex items-center justify-between px-5 py-4 border-b border-slate-200 dark:border-slate-800">
        <h2 id="agentModalTitle" class="text-base font-bold">Thêm Agent mới</h2>
        <button type="button" data-close-modal="agentModal" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <form id="agentForm" class="p-5 space-y-4">
        <input type="hidden" id="agentIdInput" />
        <div>
          <label for="agentNameInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tên Agent *</label>
          <input type="text" id="agentNameInput" required placeholder="VD: Sentinel Security" class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <div>
          <label for="agentRoleInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Vai trò chuyên môn *</label>
          <input type="text" id="agentRoleInput" required placeholder="VD: Kiểm tra bảo mật & Review code" class="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="agentModelInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Mô hình / Engine</label>
            <input type="text" id="agentModelInput" placeholder="VD: Gemini 2.5 Pro" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label for="agentCapacityInput" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Số việc chạy tối đa</label>
            <input type="number" id="agentCapacityInput" min="1" max="10" value="3" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>
